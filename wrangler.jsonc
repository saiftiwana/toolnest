{
  // Cloudflare Workers static-assets config for ToolNest.
  // html_handling:"none" keeps every .html URL exact - no auto redirect / extension stripping,
  // matching the site's existing Vercel cleanUrls:false behavior.
  // A tiny worker.js maps "/" -> "/index.html" (the one case html_handling:"none" doesn't cover).
  "name": "toolnest",
  "compatibility_date": "2026-09-24",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/"]
  }
}
